# Copy to the gitignored asc.env and fill in your App Store Connect API details.
# Keep the private .p8 key outside this repository. Never commit release secrets.
export ASC_KEY_ID=XXXXXXXXXX
export ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
export ASC_KEY_PATH="$HOME/keys/AuthKey_XXXXXXXXXX.p8"
